# Copy to .env (never commit it). Every variable is optional.
PARALLEL_AGENTS_PROVIDER=ollama          # ollama | anthropic | fake
PARALLEL_AGENTS_MODEL=qwen3:4b           # claude-sonnet-5-5 for anthropic
OLLAMA_HOST=http://127.0.0.1:11434       # loopback only unless the next line is 1
PARALLEL_AGENTS_ALLOW_REMOTE_OLLAMA=
PARALLEL_AGENTS_MAX_BRANCHES=4
PARALLEL_AGENTS_MAX_CONCURRENCY=4        # 0 = unbounded
PARALLEL_AGENTS_RETRIES=3
PARALLEL_AGENTS_CALL_TIMEOUT=120
PARALLEL_AGENTS_BRANCH_TIMEOUT=300
PARALLEL_AGENTS_MAX_TOOL_STEPS=2
PARALLEL_AGENTS_TOP_K=3
PARALLEL_AGENTS_SAMPLES=5
PARALLEL_AGENTS_TEMPERATURE=0
PARALLEL_AGENTS_CORPUS_DIR=
PARALLEL_AGENTS_FAKE_LATENCY=0
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
